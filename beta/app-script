// ===== Migration.gs =====
// Run this only against a copied beta spreadsheet.

function migrateLockoutV2Beta() {
  var properties = PropertiesService.getScriptProperties();
  if (properties.getProperty('ALLOW_V2_MIGRATION') !== 'YES') {
    throw new Error('Safety stop: set script property ALLOW_V2_MIGRATION to YES on the copied beta project first.');
  }
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    var backup = backupWorkbook();
    var added = {};
    added.sessions = v2EnsureHeaders('sessions', [
      'status', 'revision', 'auth_version', 'edit_code_verifier', 'updated_at'
    ]);
    added.players = v2EnsureHeaders('players', [
      'pin_salt', 'pin_verifier', 'pin_version', 'profile_updated_at'
    ]);
    added.edit_history = v2EnsureHeaders('edit_history', [
      'request_id', 'actor_type', 'details'
    ]);

    if (!properties.getProperty('TOKEN_SECRET')) {
      properties.setProperty('TOKEN_SECRET', Utilities.getUuid() + Utilities.getUuid() + Utilities.getUuid());
    }
    if (!properties.getProperty('MEMBER_AUTH_VERSION')) {
      properties.setProperty('MEMBER_AUTH_VERSION', '1');
    }
    var activeCodes = v2InitialiseSessionSecurity();
    properties.setProperty('SCHEMA_VERSION', '2');
    properties.deleteProperty('ALLOW_V2_MIGRATION');
    SpreadsheetApp.flush();
    var result = {
      success: true,
      backup_url: backup.url,
      headers_added: added,
      active_session_edit_codes: activeCodes,
      next_step: 'Set MEMBER_PASSPHRASE in Script Properties, then deploy the beta web app.'
    };
    console.log(JSON.stringify(result));
    return result;
  } finally {
    lock.releaseLock();
  }
}

function v2EnsureHeaders(sheetName, requiredHeaders) {
  var sheet = getSheet(sheetName);
  var headers = v2Headers(sheet);
  var added = [];
  requiredHeaders.forEach(function(header) {
    if (headers.indexOf(header) < 0) {
      sheet.getRange(1, sheet.getLastColumn() + 1).setValue(header);
      headers.push(header);
      added.push(header);
    }
  });
  return added;
}

function v2InitialiseSessionSecurity() {
  var sheet = getSheet('sessions');
  var values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];
  var headers = values[0].map(function(value) { return String(value); });
  var map = {};
  headers.forEach(function(header, index) { map[header] = index; });
  var activeCodes = [];
  var columns = {
    status: [], revision: [], auth_version: [], edit_code_verifier: [], updated_at: []
  };
  for (var row = 1; row < values.length; row++) {
    var sessionId = String(values[row][map.session_id]);
    var completed = String(values[row][map.date_ended] || '').trim() !== '';
    var existingStatus = String(values[row][map.status] || '').trim().toLowerCase();
    if (!existingStatus) values[row][map.status] = completed ? 'completed' : 'active';
    if (!values[row][map.revision]) values[row][map.revision] = 1;
    if (!values[row][map.auth_version]) values[row][map.auth_version] = 1;
    if (!values[row][map.updated_at]) values[row][map.updated_at] = v2Timestamp();
    var effectiveStatus = String(values[row][map.status] || '').trim().toLowerCase();
    if (!completed && effectiveStatus !== 'void' && !values[row][map.edit_code_verifier]) {
      var code = v2GenerateSessionCode();
      values[row][map.edit_code_verifier] = v2SessionCodeVerifier(sessionId, code);
      activeCodes.push({ session_id: sessionId, edit_code: code });
    }
    Object.keys(columns).forEach(function(header) {
      columns[header].push([values[row][map[header]]]);
    });
  }
  Object.keys(columns).forEach(function(header) {
    sheet.getRange(2, map[header] + 1, columns[header].length, 1).setValues(columns[header]);
  });
  return activeCodes;
}

