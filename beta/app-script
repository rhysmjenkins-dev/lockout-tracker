  var code = err && allowed[err.v2Code] ? err.v2Code : 'SERVER_ERROR';
  var message = code === 'SERVER_ERROR' ? 'The request could not be completed.' : String(err.message || 'Request failed.');
  return { code: code, message: message };
}

function v2OptionalLimit(value) {
  if (value === undefined || value === null || value === '') return 20;
  var n = Number(value);
  if (!isFinite(n) || n < 1) throw v2Error('VALIDATION', 'Limit must be a positive number.');
  return Math.min(Math.floor(n), 100);
}

// ===== Security.gs =====
// Lightweight security for a small, trusted group.

var V2_MEMBER_TTL_SECONDS = 90 * 24 * 60 * 60;
var V2_PROFILE_TTL_SECONDS = 30 * 60;
var V2_SESSION_TTL_SECONDS = 180 * 24 * 60 * 60;

function v2UnlockMember(p) {
  var passphrase = String(p.passphrase || '');
  var deviceId = v2Text(p.device_id || 'unknown-device', 'Device ID', 100);
  var displayName = v2Text(p.display_name || 'Friend', 'Display name', 50);
  var properties = PropertiesService.getScriptProperties();
  var expected = properties.getProperty('MEMBER_PASSPHRASE');
  if (!expected) throw v2Error('SERVER_ERROR', 'Member access has not been configured.');
  var memberAuthVersion = Number(properties.getProperty('MEMBER_AUTH_VERSION') || 1);

  var cache = CacheService.getScriptCache();
  var deviceKey = 'member_fail_device_' + v2Digest(deviceId).substring(0, 24);
  var globalKey = 'member_fail_global';
  if (Number(cache.get(deviceKey) || 0) >= 8 || Number(cache.get(globalKey) || 0) >= 200) {
    throw v2Error('MEMBER_LOCKED', 'Too many unsuccessful attempts. Try again in 15 minutes.');
  }

  if (!v2ConstantTimeEqual(v2Digest(passphrase), v2Digest(expected))) {
    v2IncrementCacheCounter(cache, deviceKey, 900);
    v2IncrementCacheCounter(cache, globalKey, 900);
    throw v2Error('AUTH_REQUIRED', 'The editing password is incorrect.');
  }

  cache.remove(deviceKey);
  cache.remove(globalKey);
  return {
    success: true,
    member_token: v2IssueToken('member', deviceId, V2_MEMBER_TTL_SECONDS, {
      label: displayName,
      v: memberAuthVersion
    })
  };
}

function v2RequireMember(p) {
  var token = v2VerifyToken(String(p.member_token || ''), 'member');
  var expectedVersion = Number(
    PropertiesService.getScriptProperties().getProperty('MEMBER_AUTH_VERSION') || 1
  );
  if (Number(token.v || 1) !== expectedVersion) {
    throw v2Error('AUTH_EXPIRED', 'Member editing access has been revoked. Unlock it again.');
  }
  return token;
}

function v2ValidateMember(p) {
  var member = v2RequireMember(p);
  return { success: true, label: member.label || 'Friend' };
}

function v2RequireProfile(p, playerId) {
  var token = v2VerifyToken(String(p.profile_token || ''), 'profile', String(playerId));
  if (Number(token.v || 1) !== v2ProfileAuthVersion(playerId)) {
    throw v2Error('AUTH_EXPIRED', 'Profile editing access has been reset. Enter the new PIN.');
  }
  return token;
}

function v2ProfileAuthVersion(playerId) {
  return Number(
    PropertiesService.getScriptProperties().getProperty('PROFILE_AUTH_VERSION_' + String(playerId)) || 1
  );
}

function v2RequireSession(p, sessionId, sessionRecord) {
  var token = v2VerifyToken(String(p.session_token || ''), 'session', String(sessionId));
  var expectedVersion = Number(sessionRecord.auth_version || 1);
  if (Number(token.v || 1) !== expectedVersion) {
    throw v2Error('SESSION_AUTH_REQUIRED', 'This session editing permission has been revoked.');
  }
  return token;
}

function v2IssueToken(kind, subject, ttlSeconds, extra) {
  var now = Math.floor(Date.now() / 1000);
  var data = {
    kind: kind,
    sub: String(subject),
    iat: now,
    exp: now + ttlSeconds,
    nonce: Utilities.getUuid()
  };
  Object.keys(extra || {}).forEach(function(key) { data[key] = extra[key]; });
  var encoded = v2Base64Url(JSON.stringify(data));
  return encoded + '.' + v2Sign(encoded);
}

function v2VerifyToken(raw, expectedKind, expectedSubject) {
  if (!raw || raw.indexOf('.') < 1) throw v2Error('AUTH_REQUIRED', 'Editing must be unlocked first.');
  var parts = raw.split('.');
  if (parts.length !== 2 || !v2ConstantTimeEqual(parts[1], v2Sign(parts[0]))) {
    throw v2Error('AUTH_REQUIRED', 'Editing permission is invalid.');
  }
  var data;
  try {
    data = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString());
  } catch (err) {
    throw v2Error('AUTH_REQUIRED', 'Editing permission is invalid.');
  }
  if (data.kind !== expectedKind) throw v2Error('AUTH_REQUIRED', 'Editing permission is invalid.');
  if (expectedSubject !== undefined && String(data.sub) !== String(expectedSubject)) {
    throw v2Error('AUTH_REQUIRED', 'Editing permission belongs to a different record.');
  }
  if (Number(data.exp) < Math.floor(Date.now() / 1000)) {
    throw v2Error('AUTH_EXPIRED', 'Editing permission has expired. Unlock it again.');
  }
  return data;
}

function v2Sign(encodedPayload) {
  var secret = PropertiesService.getScriptProperties().getProperty('TOKEN_SECRET');
  if (!secret) throw v2Error('SERVER_ERROR', 'Token security has not been configured.');
  return Utilities.base64EncodeWebSafe(
    Utilities.computeHmacSha256Signature(encodedPayload, secret)
  ).replace(/=+$/g, '');
}

function v2Base64Url(text) {
  return Utilities.base64EncodeWebSafe(String(text)).replace(/=+$/g, '');
}

function v2Digest(text) {
  return Utilities.base64EncodeWebSafe(
    Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(text), Utilities.Charset.UTF_8)
  ).replace(/=+$/g, '');
}

function v2ConstantTimeEqual(a, b) {
  a = String(a || '');
  b = String(b || '');
  var mismatch = a.length ^ b.length;
  var length = Math.max(a.length, b.length);
  for (var i = 0; i < length; i++) {
    mismatch |= (a.charCodeAt(i % Math.max(1, a.length)) || 0) ^
      (b.charCodeAt(i % Math.max(1, b.length)) || 0);
  }
  return mismatch === 0;
}

function v2IncrementCacheCounter(cache, key, ttl) {
  var next = Number(cache.get(key) || 0) + 1;
  cache.put(key, String(next), ttl);
}

function v2CheckPlayerPin(playerId) {
  var found = v2FindRow('players', 'player_id', playerId);
  if (!found) throw v2Error('NOT_FOUND', 'Player not found.');
  var hasModern = Boolean(String(found.object.pin_verifier || '').trim());
  var hasLegacy = Boolean(String(found.object.pin_hash || '').trim());
  return { success: true, has_pin: hasModern || hasLegacy };
}

function v2SetPlayerPin(p, requestId) {
  var member = v2RequireMember(p);
  var playerId = v2Id(p.player_id, 'Player');
  var pin = String(p.pin || '');
  if (!/^\d{6}$/.test(pin)) throw v2Error('VALIDATION', 'Choose a six-digit PIN.');

  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var found = v2FindRow('players', 'player_id', playerId);
    if (!found) throw v2Error('NOT_FOUND', 'Player not found.');
    if (String(found.object.pin_verifier || '').trim() || String(found.object.pin_hash || '').trim()) {
      throw v2Error('AUTH_REQUIRED', 'This player already has a PIN. The administrator must reset it.');
    }
    var salt = Utilities.getUuid();
    v2SetRowValues(found.sheet, found.rowNumber, found.headers, {
      pin_salt: salt,
      pin_verifier: v2HashPin(pin, salt),
      pin_version: 2,
      profile_updated_at: v2Timestamp()
    });
    v2AppendAudit(requestId, member.label || 'Friend', 'member', 'SET_PIN', 'player', playerId, '');
    return {
      success: true,
      profile_token: v2IssueToken('profile', playerId, V2_PROFILE_TTL_SECONDS, {
        v: v2ProfileAuthVersion(playerId)
      })
    };
  } finally {
    lock.releaseLock();
  }
}

function v2VerifyPlayerPin(p) {
  var playerId = v2Id(p.player_id, 'Player');
  var pin = String(p.pin || '');
  if (!/^\d{6}$/.test(pin)) throw v2Error('VALIDATION', 'Enter your six-digit PIN.');
  var deviceId = v2Text(p.device_id || 'unknown-device', 'Device ID', 100);
  var cache = CacheService.getScriptCache();
  var deviceFailKey = 'pin_fail_device_' + v2Digest(playerId + '|' + deviceId).substring(0, 24);
  var playerFailKey = 'pin_fail_player_' + playerId;
  if (Number(cache.get(deviceFailKey) || 0) >= 6) {
    throw v2Error('PROFILE_LOCKED', 'Too many unsuccessful attempts. Try again in 15 minutes.');
  }
  if (Number(cache.get(playerFailKey) || 0) >= 30) {
    throw v2Error('PROFILE_LOCKED', 'This profile has received too many unsuccessful attempts. Try again in 15 minutes.');
  }

  var found = v2FindRow('players', 'player_id', playerId);
  if (!found) throw v2Error('NOT_FOUND', 'Player not found.');
  var object = found.object;
  var verified = false;
  if (String(object.pin_verifier || '').trim()) {
    verified = v2ConstantTimeEqual(
      String(object.pin_verifier),
      v2HashPin(pin, String(object.pin_salt || ''))
    );
  } else if (String(object.pin_hash || '').trim()) {
    verified = v2ConstantTimeEqual(String(object.pin_hash), v2LegacySimpleHash(pin));
    if (verified) {
      var salt = Utilities.getUuid();
      v2SetRowValues(found.sheet, found.rowNumber, found.headers, {
        pin_salt: salt,
        pin_verifier: v2HashPin(pin, salt),
        pin_version: 2,
        pin_hash: '',
        profile_updated_at: v2Timestamp()
      });
    }
  }
  if (!verified) {
    v2IncrementCacheCounter(cache, deviceFailKey, 900);
    v2IncrementCacheCounter(cache, playerFailKey, 900);
    return { success: false };
  }
  cache.remove(deviceFailKey);
  cache.remove(playerFailKey);
  return {
    success: true,
    profile_token: v2IssueToken('profile', playerId, V2_PROFILE_TTL_SECONDS, {
      v: v2ProfileAuthVersion(playerId)
    })
  };
}

function v2HashPin(pin, salt) {
  var secret = PropertiesService.getScriptProperties().getProperty('TOKEN_SECRET') || '';
  return Utilities.base64EncodeWebSafe(
    Utilities.computeHmacSha256Signature(String(pin) + '|' + String(salt), secret)
  ).replace(/=+$/g, '');
}

function v2LegacySimpleHash(value) {
  var hash = 0;
  var text = String(value);
  for (var i = 0; i < text.length; i++) {
    hash = ((hash << 5) - hash) + text.charCodeAt(i);
    hash = hash | 0;
  }
  return String(Math.abs(hash));
}

function v2GenerateSessionCode() {
  var bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    Utilities.getUuid() + Utilities.getUuid(),
    Utilities.Charset.UTF_8
  );
  var number = 0;
  for (var i = 0; i < 4; i++) number = (number * 256) + (bytes[i] & 255);
  return String(100000 + (number % 900000));
}

function v2SessionCodeVerifier(sessionId, code) {
  return v2HashPin(String(code), 'session:' + String(sessionId));
}

function v2ClaimSession(p) {
  var member = v2RequireMember(p);
  var sessionId = v2Id(p.session_id, 'Session');
  var code = String(p.edit_code || '');
  if (!/^\d{6}$/.test(code)) throw v2Error('VALIDATION', 'Enter the six-digit session access code.');
  var cache = CacheService.getScriptCache();
  var deviceFailKey = 'session_claim_fail_device_' + v2Digest(sessionId + '|' + member.sub).substring(0, 24);
  var sessionFailKey = 'session_claim_fail_session_' + sessionId;
  if (Number(cache.get(deviceFailKey) || 0) >= 8) {
    throw v2Error('SESSION_AUTH_REQUIRED', 'Too many unsuccessful attempts. Try again in 15 minutes.');
  }
  if (Number(cache.get(sessionFailKey) || 0) >= 40) {
    throw v2Error('SESSION_AUTH_REQUIRED', 'This session has received too many unsuccessful attempts. Try again in 15 minutes.');
  }
  var found = v2FindRow('sessions', 'session_id', sessionId);
  if (!found) throw v2Error('NOT_FOUND', 'Session not found.');
  if (String(found.object.status || '').toLowerCase() === 'void') throw v2Error('SESSION_CLOSED', 'This session has been voided.');
  if (isSessionCompleted(found.object)) throw v2Error('SESSION_CLOSED', 'This session is already closed.');
  if (!v2ConstantTimeEqual(
    String(found.object.edit_code_verifier || ''),
    v2SessionCodeVerifier(sessionId, code)
  )) {
    v2IncrementCacheCounter(cache, deviceFailKey, 900);
    v2IncrementCacheCounter(cache, sessionFailKey, 900);
    throw v2Error('SESSION_AUTH_REQUIRED', 'The session access code is incorrect.');
  }
  cache.remove(deviceFailKey);
  cache.remove(sessionFailKey);
  var version = Number(found.object.auth_version || 1);
  return {
    success: true,
    session_token: v2IssueToken('session', sessionId, V2_SESSION_TTL_SECONDS, { v: version, label: member.label || 'Friend' }),
    revision: Number(found.object.revision || 1)
  };
}

