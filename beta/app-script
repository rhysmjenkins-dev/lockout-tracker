function adminConfigurePhotoUploadsPrompt() {
  var ui = SpreadsheetApp.getUi();
  var properties = PropertiesService.getScriptProperties();
  var enabled = Boolean(properties.getProperty('IMGBB_API_KEY'));
  var response = ui.prompt(
    'Configure photo uploads',
    (enabled ? 'Photo uploads are currently enabled. ' : '') +
      'Paste the dedicated ImgBB API key to enable uploads, or enter DISABLE to turn uploads off.',
    ui.ButtonSet.OK_CANCEL
  );
  if (response.getSelectedButton() !== ui.Button.OK) return;
  var value = String(response.getResponseText() || '').trim();
  if (value.toUpperCase() === 'DISABLE') {
    properties.deleteProperty('IMGBB_API_KEY');
    v2AppendAudit(
      Utilities.getUuid(),
      'Sheet admin',
      'admin',
      'DISABLED_PHOTOS',
      'system',
      'photo_uploads',
      ''
    );
    ui.alert('Photo uploads disabled. Existing photo links are unchanged.');
    return;
  }
  if (!/^[A-Za-z0-9_-]{16,128}$/.test(value)) {
    ui.alert('That does not look like a valid ImgBB API key. Nothing was changed.');
    return;
  }
  properties.setProperty('IMGBB_API_KEY', value);
  v2AppendAudit(
    Utilities.getUuid(),
    'Sheet admin',
    'admin',
    'ENABLED_PHOTOS',
    'system',
    'photo_uploads',
    ''
  );
  ui.alert('Photo uploads enabled. Refresh the app before testing an upload.');
}

function adminResetActiveSessionCodePrompt() {
  var ui = SpreadsheetApp.getUi();
  var response = ui.prompt(
    'Reset active session code',
    'Enter the active session ID. Existing editing permissions for that session will be revoked.',
    ui.ButtonSet.OK_CANCEL
  );
  if (response.getSelectedButton() !== ui.Button.OK) return;
  var sessionId;
  try {
    sessionId = v2Id(response.getResponseText(), 'Session');
  } catch (err) {
    ui.alert(err.message);
    return;
  }
  var confirm = ui.alert(
    'Reset session ' + sessionId + '?',
    'Anyone currently editing this session will need the new code.',
    ui.ButtonSet.YES_NO
  );
  if (confirm !== ui.Button.YES) return;
  try {
    var result = adminResetActiveSessionCode(sessionId);
    ui.alert(
      'Session code reset.\n\nNew code: ' + result.edit_code +
      '\n\nRecord it now. It cannot be recovered after this message is closed.'
    );
  } catch (err) {
    ui.alert(err.message);
  }
}

function adminResetActiveSessionCode(sessionId) {
  sessionId = v2Id(sessionId, 'Session');
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var found = v2FindRow('sessions', 'session_id', sessionId);
    if (!found) throw new Error('Session not found.');
    if (String(found.object.status || '').toLowerCase() === 'void' || isSessionCompleted(found.object)) {
      throw new Error('Only an active session can have its editing code reset.');
    }

    var editCode = v2GenerateSessionCode();
    var nextAuthVersion = Number(found.object.auth_version || 1) + 1;
    var nextRevision = Number(found.object.revision || 1) + 1;
    v2SetRowValues(found.sheet, found.rowNumber, found.headers, {
      edit_code_verifier: v2SessionCodeVerifier(sessionId, editCode),
      auth_version: nextAuthVersion,
      revision: nextRevision,
      updated_at: v2Timestamp()
    });
    CacheService.getScriptCache().remove('session_claim_fail_' + sessionId);
    v2AppendAudit(
      Utilities.getUuid(),
      'Sheet admin',
      'admin',
      'RESET_SESSION_CODE',
      'session',
      sessionId,
      'Existing session tokens revoked.'
    );
    return {
      success: true,
      edit_code: editCode,
      auth_version: nextAuthVersion,
      revision: nextRevision
    };
  } finally {
    lock.releaseLock();
  }
}

