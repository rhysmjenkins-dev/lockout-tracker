// ============================================
// CONSTANTS
// ============================================
var DEFAULT_ELO = 1000;
var PROVISIONAL_HANDS = 50;
var PROVISIONAL_K = 40;
var STANDARD_K = 24;
var DEFAULT_FALSE_LOCKOUT_PENALTY = 10;

// ============================================
// ROUTING
// ============================================
function doGet(e) {
  var action = e.parameter.action;
  try {
    switch (action) {
      case 'getPlayers':                return respond(getPlayers());
      case 'addPlayer':                 return respond(addPlayer(e.parameter.username, e.parameter.editor_name));
      case 'getSessions':               return respond(getSessions());
      case 'getRecentSessions':         return respond(getRecentSessions(e.parameter.limit));
      case 'getSession':                return respond(getSession(e.parameter.session_id));
      case 'createSession':             return respond(createSession(e.parameter.title, e.parameter.host_player_id, e.parameter.players_involved, e.parameter.notes, e.parameter.tags, e.parameter.false_lockout_penalty));
      case 'updateSession':             return respond(updateSession(e.parameter.session_id, e.parameter.notes, e.parameter.tags, e.parameter.editor_name));
      case 'updateSessionPhoto':        return respond(updateSessionPhoto(e.parameter.session_id, e.parameter.photo_url, e.parameter.editor_name));
      case 'addPlayerToSession':        return respond(addPlayerToSession(e.parameter.session_id, e.parameter.player_id, e.parameter.join_hand_number, e.parameter.editor_name));
      case 'closeSession':              return respond(closeSession(e.parameter.session_id, e.parameter.editor_name));
      case 'getHands':                  return respond(getHands(e.parameter.session_id));
      case 'addHand':                   return respond(addHand(e.parameter.session_id, e.parameter.hand_number, e.parameter.scores, e.parameter.lockout_player_id, e.parameter.false_lockout, e.parameter.editor_name, e.parameter.comment, e.parameter.lockout_score));
      case 'updateHand':                return respond(updateHand(e.parameter.session_id, e.parameter.hand_number, e.parameter.scores, e.parameter.lockout_player_id, e.parameter.false_lockout, e.parameter.editor_name, e.parameter.comment, e.parameter.lockout_score));
      case 'deleteHand':                return respond(deleteHand(e.parameter.session_id, e.parameter.hand_number, e.parameter.editor_name));
      case 'getEditHistory':            return respond(getEditHistory(e.parameter.record_type, e.parameter.record_id));
      case 'getSessionsWithHands':      return respond(getSessionsWithHands());
      case 'getHeadToHeadMatrix':       return respond(getHeadToHeadMatrix());
      case 'getPlayerComparisonDetailed': return respond(getPlayerComparisonDetailed(e.parameter.player1_id, e.parameter.player2_id));
      case 'getEloRatings':             return respond(getEloRatings());
      case 'getEloHistory':             return respond(getEloHistory(e.parameter.player_id));
      case 'getEloHistoryAll':          return respond(sheetToObjects('elo_history'));
      case 'recalculateAllElo':         return respond(recalculateAllElo());
      case 'submitFeedback':            return respond(submitFeedback(e.parameter.type, e.parameter.message, e.parameter.submitted_by));
      case 'getPlayerProfile':          return respond(getPlayerProfile(e.parameter.player_id));
      case 'updatePlayerProfile':       return respond(updatePlayerProfile(e.parameter.player_id, e.parameter.avatar_url, e.parameter.bio, e.parameter.pin_hash));
      case 'setPlayerPin':              return respond(setPlayerPin(e.parameter.player_id, e.parameter.pin_hash));
      case 'verifyPlayerPin':           return respond(verifyPlayerPin(e.parameter.player_id, e.parameter.pin_hash));
      case 'checkPlayerPin':            return respond(checkPlayerPin(e.parameter.player_id));
      case 'checkPlayerPin':            return respond(checkPlayerPin(e.parameter.player_id));
      case 'checkPlayerPin':            return respond(checkPlayerPin(e.parameter.player_id));
      default:                          return respond({ error: 'Unknown action: ' + action });
    }
  } catch (err) {
    return respond({ error: err.toString(), stack: err.stack });
  }
}

// ============================================
// UTILITY FUNCTIONS
// ============================================
function respond(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

function getSheet(name) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  if (!sheet) throw new Error('Sheet "' + name + '" not found.');
  return sheet;
}

function getNextId(sheetName) {
  var sheet = getSheet(sheetName);
  var lastRow = sheet.getLastRow();
  if (lastRow <= 1) return 1;
  var data = sheet.getRange(2, 1, lastRow - 1, 1).getValues();
  var maxId = 0;
  for (var i = 0; i < data.length; i++) {
    var val = Number(data[i][0]);
    if (val > maxId) maxId = val;
  }
  return maxId + 1;
}

function sheetToObjects(sheetName) {
  var sheet = getSheet(sheetName);
  var data = sheet.getDataRange().getValues();
  if (data.length <= 1) return [];
  var headers = data[0];
  var result = [];
  for (var i = 1; i < data.length; i++) {
    var obj = {};
    for (var j = 0; j < headers.length; j++) {
      var value = data[i][j];
      obj[headers[j]] = (value === '' || value === null || value === undefined) ? '' : value;
    }
    result.push(obj);
  }
  return result;
}

function logEdit(editorName, action, recordType, recordId) {
  var sheet = getSheet('edit_history');
  var timestamp = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss');
  var id = sheet.getLastRow(); // row 1 = headers, row 2 = id 1, etc.
  sheet.appendRow([id, timestamp, editorName, action, recordType, recordId]);
}

// ============================================
// SHARED HELPERS — BATCH D
// ============================================

// Checks whether a session has been completed
function isSessionCompleted(session) {
  var dateEnded = String(session.date_ended || '').trim();
  return dateEnded !== '' && dateEnded !== 'null' && dateEnded !== 'undefined';
}

// Safely parses player_join_info from a session, returning starting scores keyed by player ID
function parseJoinInfo(session) {
  try {
    if (!session.player_join_info || session.player_join_info === '' || session.player_join_info === '{}') return {};
    var parsed = JSON.parse(session.player_join_info);
    var result = {};
    for (var pid in parsed) {
      var info = parsed[pid];
      if (typeof info === 'object' && info.starting_score !== undefined) {
        result[String(pid)] = Number(info.starting_score);
      }
    }
    return result;
  } catch (e) {
    return {};
  }
}

// Finds a session object by ID from a pre-loaded sessions array
function findSessionById(sessions, sessionId) {
  for (var i = 0; i < sessions.length; i++) {
    if (String(sessions[i].session_id) === String(sessionId)) return sessions[i];
  }
  return null;
}

// Builds a map of completed session IDs that started before a given date
// Accepts pre-loaded sessions array to avoid repeated sheet reads
function buildCompletedSessionIdsBefore(sessions, beforeDate, excludeSessionId) {
  var map = {};
  for (var i = 0; i < sessions.length; i++) {
    var s = sessions[i];
    if (!isSessionCompleted(s)) continue;
    if (String(s.session_id) === String(excludeSessionId)) continue;
    if (new Date(s.date_started) < beforeDate) {
      map[String(s.session_id)] = true;
    }
  }
  return map;
}

// Counts unique hands played by a player in a given set of session IDs
// Accepts pre-loaded hands array to avoid repeated sheet reads
function countHandsInSessions(hands, playerId, sessionIdMap) {
  var seen = {};
  for (var i = 0; i < hands.length; i++) {
    var hand = hands[i];
    if (String(hand.player_id) === String(playerId) && sessionIdMap[String(hand.session_id)]) {
      seen[hand.session_id + '_' + hand.hand_number] = true;
    }
  }
  return Object.keys(seen).length;
}

// Extracts a lockout score value from a hand row
function getLockoutScore(hand) {
  return (hand.lockout_score !== null && hand.lockout_score !== undefined && hand.lockout_score !== '')
    ? Number(hand.lockout_score)
    : Number(hand.score);
}

// ============================================
// PLAYERS
// ============================================
function getPlayers() {
  return sheetToObjects('players');
}

function addPlayer(username, editorName) {
  if (!username || username.trim() === '') return { error: 'Username is required' };
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var existing = sheetToObjects('players');
    for (var i = 0; i < existing.length; i++) {
      if (existing[i].username.toString().toLowerCase().trim() === username.toLowerCase().trim()) {
        return { error: 'A player named "' + username + '" already exists.' };
      }
    }
    var id = getNextId('players');
    var date = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy');
    getSheet('players').appendRow([id, username, date]);
    logEdit(editorName || 'SYSTEM', 'CREATED', 'player', id);
    return { success: true, player_id: id };
  } finally {
    lock.releaseLock();
  }
}

// ============================================
// SESSIONS
// ============================================
function getSessions() {
  return sheetToObjects('sessions');
}

function getRecentSessions(limit) {
  var sessions = sheetToObjects('sessions');
  sessions.sort(function (a, b) { return new Date(b.date_started) - new Date(a.date_started); });
  var maxLimit = limit ? Math.min(Number(limit), sessions.length) : 20;
  return sessions.slice(0, maxLimit);
}

function getSession(sessionId) {
  var session = findSessionById(sheetToObjects('sessions'), sessionId);
  return session || { error: 'Session not found' };
}

function createSession(title, hostPlayerId, playersInvolved, notes, tags, falseLockoutPenalty) {
  if (!title || title.trim() === '') return { error: 'Title is required' };
  if (!hostPlayerId) return { error: 'Host player is required' };
  if (!playersInvolved) return { error: 'Players are required' };

  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var existing = sheetToObjects('sessions');
    for (var i = 0; i < existing.length; i++) {
      if (existing[i].title.toString().toLowerCase().trim() === title.toLowerCase().trim()) {
        return { error: 'A session named "' + title + '" already exists.' };
      }
    }
    var id = getNextId('sessions');
    var dateStarted = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss');
    getSheet('sessions').appendRow([
      id, title, hostPlayerId, playersInvolved, dateStarted, '',
      notes || '', tags || '', '{}', falseLockoutPenalty || DEFAULT_FALSE_LOCKOUT_PENALTY, ''
    ]);
    logEdit(hostPlayerId, 'CREATED', 'session', id);
    return { success: true, session_id: id };
  } finally {
    lock.releaseLock();
  }
}

function updateSession(sessionId, notes, tags, editorName) {
  var sheet = getSheet('sessions');
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(sessionId)) {
      if (notes !== undefined && notes !== null) sheet.getRange(i + 1, 7).setValue(notes);
      if (tags !== undefined && tags !== null) sheet.getRange(i + 1, 8).setValue(tags);
      logEdit(editorName, 'UPDATED', 'session', sessionId);
      return { success: true };
    }
  }
  return { error: 'Session not found' };
}

function updateSessionPhoto(sessionId, photoUrl, editorName) {
  var sheet = getSheet('sessions');
  var data = sheet.getDataRange().getValues();
  for (var i = 1; i < data.length; i++) {
    if (String(data[i][0]) === String(sessionId)) {
      sheet.getRange(i + 1, 11).setValue(photoUrl);
      logEdit(editorName, 'UPDATED_PHOTO', 'session', sessionId);
      return { success: true };
    }
  }
  return { error: 'Session not found' };
}

function addPlayerToSession(sessionId, playerId, joinHandNumber, editorName) {
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var sheet = getSheet('sessions');
    var data = sheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][0]) !== String(sessionId)) continue;

      var playersArray = String(data[i][3]).split(',');
      if (playersArray.indexOf(String(playerId)) !== -1) {
        return { error: 'Player already in session' };
      }

      var startingScore = 0;
      if (Number(joinHandNumber) > 1) {
        var handsData = getSheet('hands').getDataRange().getValues();
        var playerTotals = {};
        for (var h = 1; h < handsData.length; h++) {
          var hand = handsData[h];
          if (String(hand[1]) === String(sessionId) && Number(hand[2]) < Number(joinHandNumber)) {
            var hpid = String(hand[3]);
            playerTotals[hpid] = (playerTotals[hpid] || 0) + Number(hand[4]);
          }
        }
        var totalSum = 0, playerCount = 0;
        for (var pid in playerTotals) { totalSum += playerTotals[pid]; playerCount++; }
        if (playerCount > 0) startingScore = Math.round(totalSum / playerCount);
      }

      playersArray.push(String(playerId));
      sheet.getRange(i + 1, 4).setValue(playersArray.join(','));

      var joinInfo = {};
      try {
        var raw = String(data[i][8]);
        if (raw && raw !== '') joinInfo = JSON.parse(raw);
      } catch (e) { joinInfo = {}; }

      joinInfo[String(playerId)] = { hand: Number(joinHandNumber), starting_score: startingScore };
      var joinInfoStr = JSON.stringify(joinInfo);
      sheet.getRange(i + 1, 9).setValue(joinInfoStr);
      logEdit(editorName, 'ADDED_PLAYER_TO_SESSION', 'session', sessionId);
      return { success: true, players_involved: playersArray.join(','), player_join_info: joinInfoStr, starting_score: startingScore };
    }
    return { error: 'Session not found' };
  } finally {
    lock.releaseLock();
  }
}

function closeSession(sessionId, editorName) {
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var sheet = getSheet('sessions');
    var data = sheet.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][0]) !== String(sessionId)) continue;
      var dateEnded = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy HH:mm:ss');
      sheet.getRange(i + 1, 6).setValue(dateEnded);
      logEdit(editorName, 'CLOSED', 'session', sessionId);
      SpreadsheetApp.flush();
      try {
        calculateEloForSession(sessionId);
      } catch (eloErr) {
        Logger.log('ELO calculation failed for session ' + sessionId + ': ' + eloErr.toString());
      }
      return { success: true };
    }
    return { error: 'Session not found' };
  } finally {
    lock.releaseLock();
  }
}

// ============================================
// HANDS
// ============================================
function getHands(sessionId) {
  var all = sheetToObjects('hands');
  var result = [];
  for (var i = 0; i < all.length; i++) {
    if (String(all[i].session_id) === String(sessionId)) result.push(all[i]);
  }
  return result;
}

function buildHandRows(sessionId, handNumber, scores, lockoutPlayerId, falseLockout, comment, lockoutScore, startId) {
  var rows = [];
  var nextId = startId;
  for (var i = 0; i < scores.length; i++) {
    var isLockout = String(scores[i].player_id) === String(lockoutPlayerId);
    var lockoutScoreValue = isLockout
      ? ((lockoutScore !== null && lockoutScore !== undefined && lockoutScore !== '') ? Number(lockoutScore) : scores[i].score)
      : null;
    rows.push([
      nextId, sessionId, handNumber, scores[i].player_id, scores[i].score,
      isLockout ? lockoutPlayerId : '',
      (isLockout && falseLockout === 'true') ? 1 : 0,
      comment || '',
      lockoutScoreValue
    ]);
    nextId++;
  }
  return rows;
}

function addHand(sessionId, handNumber, scoresJson, lockoutPlayerId, falseLockout, editorName, comment, lockoutScore) {
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var scores = JSON.parse(scoresJson);
    var sheet = getSheet('hands');
    var rows = buildHandRows(sessionId, handNumber, scores, lockoutPlayerId, falseLockout, comment, lockoutScore, getNextId('hands'));
    if (rows.length > 0) sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, 9).setValues(rows);
    logEdit(editorName, 'ADDED_HAND', 'session', sessionId);
    return { success: true };
  } finally {
    lock.releaseLock();
  }
}

function updateHand(sessionId, handNumber, scoresJson, lockoutPlayerId, falseLockout, editorName, comment, lockoutScore) {
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var sheet = getSheet('hands');
    var data = sheet.getDataRange().getValues();
    var scores = JSON.parse(scoresJson);

    var rowsToDelete = [];
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][1]) === String(sessionId) && String(data[i][2]) === String(handNumber)) {
        rowsToDelete.push(i + 1);
      }
    }
    for (var i = rowsToDelete.length - 1; i >= 0; i--) sheet.deleteRow(rowsToDelete[i]);

    var rows = buildHandRows(sessionId, handNumber, scores, lockoutPlayerId, falseLockout, comment, lockoutScore, getNextId('hands'));
    if (rows.length > 0) sheet.getRange(sheet.getLastRow() + 1, 1, rows.length, 9).setValues(rows);
    logEdit(editorName, 'UPDATED_HAND', 'session', sessionId);
    return { success: true };
  } finally {
    lock.releaseLock();
  }
}

function deleteHand(sessionId, handNumber, editorName) {
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var sheet = getSheet('hands');
    var data = sheet.getDataRange().getValues();
    var rowsToDelete = [];
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][1]) === String(sessionId) && String(data[i][2]) === String(handNumber)) {
        rowsToDelete.push(i + 1);
      }
    }
    for (var i = rowsToDelete.length - 1; i >= 0; i--) sheet.deleteRow(rowsToDelete[i]);
    logEdit(editorName, 'DELETED_HAND', 'session', sessionId);
    return { success: true };
  } finally {
    lock.releaseLock();
  }
}

